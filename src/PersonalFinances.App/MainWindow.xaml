     <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Categorías" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/><DataGrid x:Name="CategoriesGrid" CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="False" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Height="275"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Nombre" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn Header="Activa" Binding="{Binding Active}" Width="90"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,14,0,0"><Button Content="+ Agregar categoría" Command="{Binding NewCategoryCommand}" Margin="0,0,8,0"/><Button Content="Editar / desactivar" Command="{Binding EditCategoryCommand}"/></WrapPanel></StackPanel></Border>
     <TextBlock Text="Personal Finances 1.8.2 · .NET 10 · WPF · MySQL local" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,18"/>
    </StackPanel></ScrollViewer>
   </Grid>
   <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Sync}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Grid.Column="1" Text="ARS y USD siempre separados" Foreground="{StaticResource Muted}" FontSize="11"/></Grid>
  </Grid>
 </Grid>
