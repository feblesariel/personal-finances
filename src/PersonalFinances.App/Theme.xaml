  <Style x:Key="SidebarItem" TargetType="{x:Type local:NavigationButton}" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CDDAEF"/><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="13"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="ToolTip" Value="{Binding Content,RelativeSource={RelativeSource Self}}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:NavigationButton}">
    <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="IconContainer" Width="24" VerticalAlignment="Center"><Path x:Name="IconGlyph" Data="{TemplateBinding Icon}" Width="18" Height="18" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock x:Name="NavLabel" Grid.Column="2" Text="{TemplateBinding Content}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsActive" Value="False"/></MultiTrigger.Conditions><Setter TargetName="NavBorder" Property="Background" Value="#253B5B"/></MultiTrigger>
     <Trigger Property="IsActive" Value="True"><Setter Property="Background" Value="#29466F"/><Setter Property="Foreground" Value="White"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="#93B4FF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Opacity" Value="0.85"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="CaretBrush" Value="{StaticResource Ink}"/><Setter Property="SelectionBrush" Value="{StaticResource Accent}"/><Setter Property="SelectionOpacity" Value="0.25"/><Setter Property="BorderBrush" Value="#D5DEEA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="TextBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
     <Grid>
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}" Margin="0"/>
      <TextBlock x:Name="InputHint" Text="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(local:InputAssist.Hint)}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="Text" Value=""><Setter TargetName="InputHint" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TextBorder" Property="BorderBrush" Value="#2563EB"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextBorder" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EDF3FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E1EBFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBox"><Setter Property="IsSynchronizedWithCurrentItem" Value="False"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="38"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5DEEA"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock Margin="10,7,2,7" Text="{Binding Text,RelativeSource={RelativeSource AncestorType=ComboBox}}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/><Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="#627188" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#9AAECC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border Background="White" BorderBrush="#CAD6E8" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280" Margin="0,3,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DatePicker"><Setter Property="Padding" Value="5"/><Setter Property="MinHeight" Value="38"/><Setter Property="Language" Value="es-AR"/><Setter Property="SelectedDateFormat" Value="Short"/></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="5,2"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF1F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="42"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#FBFCFE"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F6F8FC"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="10,12"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Surface" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/><Setter Property="BorderBrush" Value="#E6EBF3"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Geometry x:Key="NavServices">M0,0 H18 V18 L15,16 12,18 9,16 6,18 3,16 0,18 Z M4,5 H14 M4,9 H14 M4,13 H10</Geometry>
  <DataTemplate x:Key="BarTemplate"><StackPanel Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="13"/><TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="SemiBold" Margin="8,0,0,0"/></Grid><Grid Margin="0,7,0,0"><Border Background="#EEF2FA" Height="6" CornerRadius="3"/><Border Background="#4C7DEE" Width="{Binding Width}" Height="6" CornerRadius="3" HorizontalAlignment="Left" MaxWidth="240"/></Grid><TextBlock Text="{Binding Percent}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:MovementEditor}">
   <StackPanel>
    <TextBlock Text="IMPORTE" Style="{StaticResource Label}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox x:Name="AmountInput" AutomationProperties.AutomationId="AmountInput" Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}" FontSize="30" FontWeight="SemiBold" Margin="0,0,12,0" MaxLength="24"/><ComboBox Grid.Column="1" ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}"/></Grid>
    <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Fecha" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Date}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Tarjeta" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Cards}" SelectedItem="{Binding Card}" IsTextSearchEnabled="True"/></StackPanel></Grid>
    <TextBlock Text="Categoría" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" IsTextSearchEnabled="True"/>
    <TextBlock Text="Comercio o descripción · opcional" Style="{StaticResource Label}"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
    <TextBlock Text="{Binding Assignment}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,12"/>
    <Expander Header="Detalles adicionales / reintegros" Margin="0,0,0,12"><StackPanel Margin="0,10,0,0"><CheckBox Content="Es un reintegro / devolución" IsChecked="{Binding Refund}"/><TextBlock Text="Consumo original · vínculo opcional" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Originals}" SelectedItem="{Binding Original}" DisplayMemberPath="OriginalLabel" IsEnabled="{Binding Refund}"/><Button Content="Quitar vínculo" Command="{Binding ClearOriginalCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Style="{StaticResource CompactButton}"/><CheckBox Content="Seleccionar período manualmente" IsChecked="{Binding Manual}" Margin="0,14,0,4"/><ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" IsEnabled="{Binding Manual}"/><TextBlock Text="Observaciones" Style="{StaticResource Label}"/><TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="65" MaxLength="4000" TextWrapping="Wrap"/></StackPanel></Expander>
    <CheckBox Content="Seguir cargando después de guardar" IsChecked="{Binding KeepOpen}" Visibility="{Binding IsNew,Converter={StaticResource BoolVisibility}}"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:PeriodEditor}"><StackPanel>
   <TextBlock Text="Tarjeta" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Cards}" SelectedItem="{Binding Card}" IsEnabled="{Binding CanChangeCard}"/>
   <TextBlock Text="Nombre del período · ejemplo: Resumen noviembre 2026" Style="{StaticResource Label}"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
   <TextBlock Text="Inicio del período" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Start}"/>
   <TextBlock Text="Fecha de cierre" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Closing}"/>
   <TextBlock Text="Fecha de vencimiento" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Due}"/>
   <Border Background="#EFF5FF" CornerRadius="8" Padding="14" Margin="0,20,0,0"><TextBlock FontSize="12" Text="Al guardar se verifican las superposiciones y se recalculan las asignaciones automáticas. Los consumos fuera de las nuevas fechas quedarán visibles como pendientes. Las imputaciones manuales se conservan y se advierten si quedan fuera de fecha."/></Border>
  </StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:NameEditor}"><StackPanel><TextBlock Text="Nombre" Style="{StaticResource Label}"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/><CheckBox Content="Activa" IsChecked="{Binding Active}" Margin="0,22,0,0"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:ConnectionEditor}"><StackPanel>
   <TextBlock Text="Servidor / Host" Style="{StaticResource Label}"/><TextBox Text="{Binding Host,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ConnectionHost"/>
   <TextBlock Text="Puerto" Style="{StaticResource Label}"/><TextBox Text="{Binding Port,UpdateSourceTrigger=PropertyChanged}"/>
   <TextBlock Text="Usuario" Style="{StaticResource Label}"/><TextBox Text="{Binding User,UpdateSourceTrigger=PropertyChanged}"/>
   <TextBlock Text="Contraseña" Style="{StaticResource Label}"/><PasswordBox PasswordChanged="ConnectionPasswordChanged" Padding="10"/><TextBlock Text="{Binding PasswordHelp}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
   <TextBlock Text="Nombre de la base de datos" Style="{StaticResource Label}"/><TextBox Text="{Binding Database,UpdateSourceTrigger=PropertyChanged}"/>
   <Button Content="Probar conexión" Command="{Binding TestCommand}" HorizontalAlignment="Left" Margin="0,16,0,10"/>
   <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#315DA8"/><CheckBox Content="Crear la base si no existe (requiere permiso CREATE)" IsChecked="{Binding CreateDatabase}" Margin="0,12,0,0"/>
   <TextBlock Text="Guardá solo un usuario propio con permisos sobre esta base. La contraseña se protege con DPAPI en este equipo. No se modifica ni elimina otra base." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/>
  </StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:ExportEditor}"><StackPanel>
   <TextBlock Text="Carpeta de destino" Style="{StaticResource Label}"/><TextBox Text="{Binding Folder,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ExportFolder"/>
   <WrapPanel Margin="0,14,0,14"><Button Content="Seleccionar carpeta" Command="{Binding PickCommand}" Margin="0,0,8,0"/><Button Content="Probar escritura" Command="{Binding TestCommand}"/></WrapPanel>
   <TextBlock Text="Archivo de resumen" Style="{StaticResource Label}"/><TextBlock Text="{Binding Destination}"/><TextBlock Text="{Binding Status}" Foreground="#315DA8" Margin="0,16,0,0"/>
   <TextBlock Text="La carpeta y el estado de exportación se guardan localmente por instalación. Si la unidad no está disponible, los movimientos se conservan en MySQL y el TXT se reintenta automáticamente." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/>
  </StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:ImportEditor}"><StackPanel><TextBlock Text="{Binding Summary}" Margin="0,8,0,16"/><WrapPanel Margin="0,0,0,12"><Button Content="Revisar / corregir línea seleccionada" Command="{Binding ReviewCommand}" Margin="0,0,8,0"/></WrapPanel><DataGrid x:Name="ImportPreviewGrid" CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="False" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Height="340" IsReadOnly="False" RowHeight="52"><DataGrid.Columns><DataGridCheckBoxColumn Header="Importar" Binding="{Binding Include,UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Línea" Binding="{Binding Line}" IsReadOnly="True" Width="48"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Fecha" Binding="{Binding Date}" IsReadOnly="True" Width="92"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Tarjeta" Binding="{Binding Card}" IsReadOnly="True" Width="95"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Descripción" Binding="{Binding Description}" IsReadOnly="True" Width="160"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Categoría" Binding="{Binding Category}" IsReadOnly="True" Width="140"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Importe" Binding="{Binding Amount}" IsReadOnly="True" Width="125"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Revisión" Binding="{Binding Problem}" IsReadOnly="True" Width="240"/></DataGrid.Columns></DataGrid><TextBlock Text="Las líneas ambiguas y los duplicados requieren revisión expresa. La importación completa se guarda en una única transacción." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:ImportRowEditor}"><StackPanel><Border Background="#EFF3F9" Padding="12" CornerRadius="8"><TextBlock Text="{Binding Raw}"/></Border><TextBlock Text="Fecha" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Date}"/><TextBlock Text="Tarjeta" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Cards}" SelectedItem="{Binding Card}"/><TextBlock Text="Importe" Style="{StaticResource Label}"/><TextBox Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Moneda" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}"/><TextBlock Text="Categoría" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/><TextBlock Text="Descripción" Style="{StaticResource Label}"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Reintegro / devolución" IsChecked="{Binding Refund}" Margin="0,16,0,0"/></StackPanel></DataTemplate>

  <DataTemplate DataType="{x:Type local:BackupExportEditor}"><StackPanel>
   <TextBlock Text="Archivo de destino" Style="{StaticResource Label}"/><TextBlock Text="{Binding Path}" FontSize="12" TextWrapping="Wrap"/>
   <TextBlock Text="Contraseña del respaldo" Style="{StaticResource Label}"/><PasswordBox PasswordChanged="BackupPasswordChanged" Padding="10" MaxLength="1024" AutomationProperties.AutomationId="BackupPassword"/>
   <TextBlock Text="Repetir contraseña" Style="{StaticResource Label}"/><PasswordBox PasswordChanged="BackupPasswordChanged" Tag="Confirm" Padding="10" MaxLength="1024" AutomationProperties.AutomationId="BackupPasswordConfirmation"/>
   <Border Background="#EFF5FF" CornerRadius="8" Padding="14" Margin="0,18,0,14"><TextBlock FontSize="12" Text="Usá al menos 12 caracteres. Necesitarás esta contraseña para importar el respaldo en cualquier equipo. No se guarda y no se puede recuperar si la olvidás."/></Border>
   <TextBlock Text="Incluye todo el historial, reintegros y auditoría. Las credenciales, la carpeta de resumen y las preferencias de este equipo quedan fuera del archivo." FontSize="12" Foreground="{StaticResource Muted}"/>
   <ProgressBar IsIndeterminate="True" Height="4" Margin="0,18,0,10" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Status}" FontSize="12" Foreground="#315DA8" Margin="0,10,0,0"/>
  </StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:BackupRestoreEditor}"><StackPanel>
   <TextBlock Text="Archivo seleccionado" Style="{StaticResource Label}"/><TextBlock Text="{Binding Path}" FontSize="12"/>
   <StackPanel Visibility="{Binding NeedsPassword,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Contraseña del respaldo" Style="{StaticResource Label}"/><PasswordBox PasswordChanged="BackupPasswordChanged" Padding="10" MaxLength="1024" AutomationProperties.AutomationId="BackupPassword"/><TextBlock Text="Validaremos el archivo y guardaremos una copia cifrada de los datos actuales antes de pedirte la confirmación. La copia previa utiliza esta misma contraseña." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/></StackPanel>
   <StackPanel Visibility="{Binding PreviewAvailable,Converter={StaticResource BoolVisibility}}">
    <Border Background="#EFF5FF" CornerRadius="8" Padding="14" Margin="0,18,0,12"><TextBlock Text="{Binding Preview}" FontSize="12" AutomationProperties.AutomationId="BackupPreview"/></Border>
    <TextBlock Text="Esta restauración reemplazará los datos contables actuales por los contenidos en el respaldo seleccionado." Foreground="#9A3412" FontWeight="SemiBold" FontSize="13"/>
    <TextBlock Text="Se conservan la conexión MySQL y la carpeta de resumen de este equipo. No se mezclan datos." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
    <TextBlock Text="Copia previa verificada · misma contraseña del respaldo" Style="{StaticResource Label}"/><TextBlock Text="{Binding SafetyPath}" FontSize="11" TextWrapping="Wrap"/>
    <CheckBox IsChecked="{Binding ConfirmReplacement}" Margin="0,18,0,4" AutomationProperties.AutomationId="ConfirmRestore"><TextBlock Text="Confirmo que quiero reemplazar toda la contabilidad actual." TextWrapping="Wrap"/></CheckBox>
   </StackPanel>
   <ProgressBar IsIndeterminate="True" Height="4" Margin="0,18,0,10" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Status}" FontSize="12" Foreground="#315DA8" Margin="0,10,0,0"/>
  </StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:ServiceEditor}"><StackPanel>
   <TextBlock Text="Nombre" Style="{StaticResource Label}"/><TextBox Text="{Binding Model.Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
   <TextBlock Text="Tipo" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}"/>
   <TextBlock Text="Periodicidad" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}"/>
   <StackPanel Visibility="{Binding SingleCurrency,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Moneda" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding Model.Currency}"/></StackPanel>
   <TextBlock Text="{Binding AmountLabel}" Style="{StaticResource Label}"/><TextBox Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}"/>
   <TextBlock Text="Los resúmenes se controlan por su importe final en ARS, sin conversiones automáticas." FontSize="12" Foreground="{StaticResource Muted}" Visibility="{Binding IsCard,Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0"/>
   <StackPanel Visibility="{Binding IsAnnual,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Mes de renovación anual (1–12)" Style="{StaticResource Label}"/><TextBox Text="{Binding Model.DueMonth}"/></StackPanel>
   <TextBlock Text="El vencimiento se completa en cada período, cuando lo conozcas." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
   <TextBlock Text="Observaciones" Style="{StaticResource Label}"/><TextBox Text="{Binding Model.Notes}" MaxLength="4000"/>
   <CheckBox Content="Servicio activo" IsChecked="{Binding Model.Active}" Margin="0,16,0,0"/>
  </StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:ObligationEditor}"><StackPanel>
   <TextBlock Text="Período (seleccioná cualquier día del mes)" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Model.Period}" IsEnabled="{Binding NewPeriod}"/>
   <TextBlock Text="Vencimiento real (opcional)" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Model.Due}"/>
   <TextBlock Text="{Binding AmountLabel}" Style="{StaticResource Label}"/><TextBox Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}"/>
   <StackPanel Visibility="{Binding DualCurrency,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Importe del resumen en USD" Style="{StaticResource Label}"/><TextBox Text="{Binding AmountUsd,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><TextBlock Text="Moneda" Style="{StaticResource Label}"/><TextBlock Text="{Binding Model.Currency}"/>
   <StackPanel Visibility="{Binding IsCard,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Pago mínimo (opcional)" Style="{StaticResource Label}"/><TextBox Text="{Binding Minimum,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <TextBlock Text="Número de cuota (opcional)" Style="{StaticResource Label}"/><TextBox Text="{Binding Installment}"/>
   <TextBlock Text="Total de cuotas (opcional)" Style="{StaticResource Label}"/><TextBox Text="{Binding Installments}"/>
   <TextBlock Text="Observaciones" Style="{StaticResource Label}"/><TextBox Text="{Binding Model.Notes}" MaxLength="4000"/>
  </StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:ServicePaymentEditor}"><StackPanel>
   <TextBlock Text="Importe abonado" Style="{StaticResource Label}"/><TextBox Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}"/>
   <TextBlock Text="Moneda de la obligación" Style="{StaticResource Label}"/><TextBlock Text="{Binding Currency}"/>
   <TextBlock Text="Fecha real del pago" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Model.Date}"/>
   <TextBlock Text="Medio de pago (informativo)" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Model.Method}"/>
   <TextBlock Text="Observaciones" Style="{StaticResource Label}"/><TextBox Text="{Binding Model.Notes}" MaxLength="4000"/>
  </StackPanel></DataTemplate>
  <Style x:Key="SheetStatusText" TargetType="TextBlock" BasedOn="{StaticResource GridText}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#627188"/><Style.Triggers><DataTrigger Binding="{Binding BaseStatus}" Value="Pagado"><Setter Property="Foreground" Value="#18704A"/></DataTrigger><DataTrigger Binding="{Binding BaseStatus}" Value="Parcial"><Setter Property="Foreground" Value="#966100"/></DataTrigger><DataTrigger Binding="{Binding BaseStatus}" Value="Pendiente"><Setter Property="Foreground" Value="#315E96"/></DataTrigger></Style.Triggers></Style>
  <DataTemplate DataType="{x:Type local:ServiceMonthEditor}"><StackPanel><TextBlock Text="Mes del nuevo período" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Month}"/><TextBlock Text="Podés elegir cualquier día del mes. Los meses anteriores quedan guardados." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:ServicePaymentsEditor}"><StackPanel><WrapPanel Margin="0,0,0,12"><Button Content="Agregar pago" Command="{Binding AddCommand}" Margin="0,0,8,0"/><Button Content="Corregir" Command="{Binding EditCommand}" Margin="0,0,8,0"/><Button Content="Anular" Command="{Binding VoidCommand}"/></WrapPanel><DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding Selected}" Height="260"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Payment.Date,StringFormat=dd/MM/yyyy}" Width="110"/><DataGridTextColumn Header="Importe" Binding="{Binding Amount}" Width="145"/><DataGridTextColumn Header="Medio" Binding="{Binding Payment.Method}" Width="120"/><DataGridTextColumn Header="Observaciones" Binding="{Binding Payment.Notes}" Width="*" MinWidth="170"/><DataGridCheckBoxColumn Header="Anulado" Binding="{Binding Payment.Voided}" Width="75"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding Archive}" Foreground="#966100" FontSize="12" Margin="0,14,0,0"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:ServiceEntryEditor}"><StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
   <TextBlock Text="Importe del período" Style="{StaticResource Label}"/><TextBox Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}" ToolTip="Vacío = Sin cargar. 0 = Sin cargo." AutomationProperties.AutomationId="ServiceAmount"/>
   <TextBlock Text="Nuevo monto abonado (opcional)" Style="{StaticResource Label}"/><TextBox Text="{Binding NewPayment,UpdateSourceTrigger=PropertyChanged}" ToolTip="Importe de este nuevo pago; se suma a los anteriores. Dejá vacío para guardar sin pago." AutomationProperties.AutomationId="ServiceNewPayment"/>
   <TextBlock Text="Fecha del pago" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding PaymentDate,UpdateSourceTrigger=PropertyChanged}" Tag="PaymentDate" DateValidationError="ServiceDateError" LostFocus="ServiceDateFocus" AutomationProperties.AutomationId="ServicePaymentDate"/>
   <TextBlock Text="Fecha de vencimiento (opcional)" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Due,UpdateSourceTrigger=PropertyChanged}" Tag="Due" DateValidationError="ServiceDateError" LostFocus="ServiceDateFocus" AutomationProperties.AutomationId="ServiceDue"/>
   <TextBlock Text="{Binding Coverage}" Foreground="#18704A" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,14,0,0"><Button Content="Historial" Command="{Binding HistoryCommand}" Style="{StaticResource CompactButton}" Margin="0,0,8,8"/><Button Content="Datos del servicio" Command="{Binding GeneralCommand}" Style="{StaticResource CompactButton}" Margin="0,0,8,8"/><Button Content="Eliminar servicio" Command="{Binding DeleteCommand}" Style="{StaticResource CompactButton}" Foreground="#A63737" Margin="0,0,0,8"/></WrapPanel>
   <Button Content="Registrar renovación anual" Command="{Binding RenewCommand}" Visibility="{Binding CanRenew,Converter={StaticResource BoolVisibility}}" Style="{StaticResource CompactButton}" HorizontalAlignment="Left"/>
  </StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:DeleteServiceEditor}"><StackPanel><TextBlock Text="{Binding Warning}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/><Button Content="Generar respaldo de recuperación…" Command="{Binding BackupCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding BackupStatus}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,16"/><CheckBox Content="Confirmo eliminar definitivamente el servicio y todo su historial" IsChecked="{Binding ConfirmDelete}"/></StackPanel></DataTemplate>
</ResourceDictionary>
