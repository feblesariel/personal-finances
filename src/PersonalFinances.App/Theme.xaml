<ResourceDictionary x:Class="PersonalFinances.App.Theme" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PersonalFinances.App">

  <local:PageVisibilityConverter x:Key="PageVisibility"/>
  <local:BoolVisibilityConverter x:Key="BoolVisibility"/>
  <SolidColorBrush x:Key="Ink" Color="#17253C"/><SolidColorBrush x:Key="Muted" Color="#627188"/><SolidColorBrush x:Key="Accent" Color="#2563EB"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#F4F6FA"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,14,0,6"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="GridText" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#DCE2EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.83"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#2563EB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Style>
  <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CDDAEF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,3"/><Setter Property="Height" Value="44"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="14,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#253B5B"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#253B5B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5DEEA"/><Setter Property="Padding" Value="11,9"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="TextBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TextBorder" Property="BorderBrush" Value="#2563EB"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextBorder" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EDF3FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E1EBFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="38"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5DEEA"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock Margin="10,7,2,7" Text="{Binding Text,RelativeSource={RelativeSource AncestorType=ComboBox}}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/><Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="#627188" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#9AAECC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border Background="White" BorderBrush="#CAD6E8" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280" Margin="0,3,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DatePicker"><Setter Property="Padding" Value="5"/><Setter Property="MinHeight" Value="38"/><Setter Property="Language" Value="es-AR"/><Setter Property="SelectedDateFormat" Value="Short"/></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="5,2"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF1F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="42"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#FBFCFE"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F6F8FC"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="10,12"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Surface" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/><Setter Property="BorderBrush" Value="#E6EBF3"/><Setter Property="BorderThickness" Value="1"/></Style>
  <DataTemplate x:Key="BarTemplate"><StackPanel Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="13"/><TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="SemiBold" Margin="8,0,0,0"/></Grid><Grid Margin="0,7,0,0"><Border Background="#EEF2FA" Height="6" CornerRadius="3"/><Border Background="#4C7DEE" Width="{Binding Width}" Height="6" CornerRadius="3" HorizontalAlignment="Left" MaxWidth="240"/></Grid><TextBlock Text="{Binding Percent}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:MovementEditor}">
   <StackPanel>
    <TextBlock Text="IMPORTE" Style="{StaticResource Label}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox x:Name="AmountInput" AutomationProperties.AutomationId="AmountInput" Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}" FontSize="30" FontWeight="SemiBold" Margin="0,0,12,0" MaxLength="24"/><ComboBox Grid.Column="1" ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}"/></Grid>
    <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Fecha" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Date}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Tarjeta" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Cards}" SelectedItem="{Binding Card}" IsTextSearchEnabled="True"/></StackPanel></Grid>
    <TextBlock Text="Categoría" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" IsTextSearchEnabled="True"/>
    <TextBlock Text="Comercio o descripción · opcional" Style="{StaticResource Label}"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
    <TextBlock Text="{Binding Assignment}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,12"/>
    <Expander Header="Detalles adicionales / reintegros" Margin="0,0,0,12"><StackPanel Margin="0,10,0,0"><CheckBox Content="Es un reintegro / devolución" IsChecked="{Binding Refund}"/><TextBlock Text="Consumo original · vínculo opcional" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Originals}" SelectedItem="{Binding Original}" DisplayMemberPath="OriginalLabel" IsEnabled="{Binding Refund}"/><Button Content="Quitar vínculo" Command="{Binding ClearOriginalCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Style="{StaticResource CompactButton}"/><CheckBox Content="Seleccionar período manualmente" IsChecked="{Binding Manual}" Margin="0,14,0,4"/><ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" IsEnabled="{Binding Manual}"/><TextBlock Text="Observaciones" Style="{StaticResource Label}"/><TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="65" MaxLength="4000" TextWrapping="Wrap"/></StackPanel></Expander>
    <CheckBox Content="Seguir cargando después de guardar" IsChecked="{Binding KeepOpen}" Visibility="{Binding IsNew,Converter={StaticResource BoolVisibility}}"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type local:PeriodEditor}"><StackPanel>
   <TextBlock Text="Tarjeta" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Cards}" SelectedItem="{Binding Card}" IsEnabled="{Binding CanChangeCard}"/>
   <TextBlock Text="Nombre del período · ejemplo: Resumen noviembre 2026" Style="{StaticResource Label}"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
   <TextBlock Text="Inicio del período" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Start}"/>
   <TextBlock Text="Fecha de cierre" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Closing}"/>
   <TextBlock Text="Fecha de vencimiento" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Due}"/>
   <Border Background="#EFF5FF" CornerRadius="8" Padding="14" Margin="0,20,0,0"><TextBlock FontSize="12" Text="Al guardar se verifican las superposiciones y se recalculan las asignaciones automáticas. Los consumos fuera de las nuevas fechas quedarán visibles como pendientes. Las imputaciones manuales se conservan y se advierten si quedan fuera de fecha."/></Border>
  </StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:NameEditor}"><StackPanel><TextBlock Text="Nombre" Style="{StaticResource Label}"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/><CheckBox Content="Activa" IsChecked="{Binding Active}" Margin="0,22,0,0"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:ConnectionEditor}"><StackPanel>
   <TextBlock Text="Servidor / Host" Style="{StaticResource Label}"/><TextBox Text="{Binding Host,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ConnectionHost"/>
   <TextBlock Text="Puerto" Style="{StaticResource Label}"/><TextBox Text="{Binding Port,UpdateSourceTrigger=PropertyChanged}"/>
   <TextBlock Text="Usuario" Style="{StaticResource Label}"/><TextBox Text="{Binding User,UpdateSourceTrigger=PropertyChanged}"/>
   <TextBlock Text="Contraseña" Style="{StaticResource Label}"/><PasswordBox PasswordChanged="ConnectionPasswordChanged" Padding="10"/><TextBlock Text="{Binding PasswordHelp}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
   <TextBlock Text="Nombre de la base de datos" Style="{StaticResource Label}"/><TextBox Text="{Binding Database,UpdateSourceTrigger=PropertyChanged}"/>
   <Button Content="Probar conexión" Command="{Binding TestCommand}" HorizontalAlignment="Left" Margin="0,16,0,10"/>
   <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#315DA8"/><CheckBox Content="Crear la base si no existe (requiere permiso CREATE)" IsChecked="{Binding CreateDatabase}" Margin="0,12,0,0"/>
   <TextBlock Text="Guardá solo un usuario propio con permisos sobre esta base. La contraseña se protege con DPAPI en este equipo. No se modifica ni elimina otra base." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/>
  </StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:ExportEditor}"><StackPanel>
   <TextBlock Text="Carpeta de destino" Style="{StaticResource Label}"/><TextBox Text="{Binding Folder,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ExportFolder"/>
   <WrapPanel Margin="0,14,0,14"><Button Content="Seleccionar carpeta" Command="{Binding PickCommand}" Margin="0,0,8,0"/><Button Content="Probar escritura" Command="{Binding TestCommand}"/></WrapPanel>
   <TextBlock Text="Archivo de resumen" Style="{StaticResource Label}"/><TextBlock Text="{Binding Destination}"/><TextBlock Text="{Binding Status}" Foreground="#315DA8" Margin="0,16,0,0"/>
   <TextBlock Text="La carpeta y el estado de exportación se guardan localmente por instalación. Si la unidad no está disponible, los movimientos se conservan en MySQL y el TXT se reintenta automáticamente." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/>
  </StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:ImportEditor}"><StackPanel><TextBlock Text="{Binding Summary}" Margin="0,8,0,16"/><WrapPanel Margin="0,0,0,12"><Button Content="Revisar / corregir línea seleccionada" Command="{Binding ReviewCommand}" Margin="0,0,8,0"/><Button Content="Restablecer tabla" Command="{x:Static local:TableLayout.ResetCommand}" CommandTarget="{Binding ElementName=ImportPreviewGrid}"/></WrapPanel><DataGrid x:Name="ImportPreviewGrid" local:TableLayout.Key="import-preview" local:TableLayout.DefaultSort="Line:Ascending" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Height="340" IsReadOnly="False" RowHeight="52"><DataGrid.Columns><DataGridCheckBoxColumn Header="Importar" Binding="{Binding Include,UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Línea" Binding="{Binding Line}" IsReadOnly="True" Width="48"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Fecha" Binding="{Binding Date}" IsReadOnly="True" Width="92"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Tarjeta" Binding="{Binding Card}" IsReadOnly="True" Width="95"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Descripción" Binding="{Binding Description}" IsReadOnly="True" Width="160"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Categoría" Binding="{Binding Category}" IsReadOnly="True" Width="140"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Importe" Binding="{Binding Amount}" IsReadOnly="True" Width="125"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Revisión" Binding="{Binding Problem}" IsReadOnly="True" Width="240"/></DataGrid.Columns></DataGrid><TextBlock Text="Las líneas ambiguas y los duplicados requieren revisión expresa. La importación completa se guarda en una única transacción." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type local:ImportRowEditor}"><StackPanel><Border Background="#EFF3F9" Padding="12" CornerRadius="8"><TextBlock Text="{Binding Raw}"/></Border><TextBlock Text="Fecha" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Date}"/><TextBlock Text="Tarjeta" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Cards}" SelectedItem="{Binding Card}"/><TextBlock Text="Importe" Style="{StaticResource Label}"/><TextBox Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Moneda" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}"/><TextBlock Text="Categoría" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/><TextBlock Text="Descripción" Style="{StaticResource Label}"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Reintegro / devolución" IsChecked="{Binding Refund}" Margin="0,16,0,0"/></StackPanel></DataTemplate>

</ResourceDictionary>
