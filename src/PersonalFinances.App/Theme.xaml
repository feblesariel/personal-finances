  <Geometry x:Key="NavStatistics">M0,0 V18 H18 M4,14 V9 H7 V14 Z M10,14 V4 H13 V14 Z M16,14 V1 H18 V14 Z</Geometry>
  <Geometry x:Key="NavCards">M3,0 H17 V3 H3 Z M0,6 H18 V18 H0 Z M0,10 H18 M4,14 H8</Geometry>
