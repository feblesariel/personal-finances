<Window x:Class="PersonalFinances.App.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="560" Height="760" MinWidth="450" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize" Background="White" Style="{StaticResource {x:Type Window}}" Icon="Assets/app.ico">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl x:Name="EditorContent" Content="{Binding}" Margin="0,0,10,0"/></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="{Binding Error}" Foreground="#315E96" Margin="0,0,0,12" AutomationProperties.AutomationId="EditorFeedback"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Cancelar · Esc" MinWidth="145" Command="{Binding CancelCommand}" HorizontalAlignment="Left"/><Button Grid.Column="1" Content="{Binding SaveLabel}" MinWidth="145" Command="{Binding SaveCommand}" Style="{StaticResource Primary}" IsDefault="True" AutomationProperties.AutomationId="SaveButton"/></Grid></StackPanel>
 </Grid>
</Window>
